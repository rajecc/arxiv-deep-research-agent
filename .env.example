# =====================================================================
# LLM Provider Configuration (gemini or openai_compatible)
# =====================================================================
DEFAULT_LLM_PROVIDER=gemini

# Option 1: Google Gemini (Direct API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Option 2: OpenAI-Compatible / VseLLM / OpenRouter / DeepSeek API
OPENAI_API_KEY=your_vsellm_or_openai_api_key_here
OPENAI_BASE_URL=https://api.vllm.example.com/v1
OPENAI_MODEL=deepseek-chat

# Logging & Debug
LOG_LEVEL=INFO
DEBUG=false
